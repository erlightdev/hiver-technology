{
  "context_servers": {
    "better-t-stack": {
      "source": "custom",
      "command": "npx",
      "args": ["create-better-t-stack@latest", "mcp"],
      "env": {}
    },
    "context7": {
      "source": "custom",
      "command": "npx",
      "args": ["-y", "@upstash/context7-mcp"],
      "env": {}
    },
    "shadcn": {
      "source": "custom",
      "command": "npx",
      "args": ["-y", "shadcn@latest", "mcp"],
      "env": {}
    }
  }
}
